// ─────────────────────────────────────────────────────────────────────────────
// Atlas core data model.
//
// Design principles (see docs/data-model.md):
//   1. Every domain record belongs to a User (single-user today, multi-user ready).
//   2. Anything that "happens" also writes a TimelineEvent  -> the unified life log
//      the AI reads. Domain tables are the source of truth; the timeline is the
//      chronological, cross-domain view.
//   3. `type` / `kind` / `source` fields are Strings, NOT enums, wherever a future
//      module might introduce new values. New modules must not require a migration
//      of shared tables. Enums are used only where the set is truly fixed.
//   4. Sensitive external secrets live ONLY in Credential.dataEnc, encrypted at the
//      app layer (AES-256-GCM) before they ever reach the DB.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Pooled (PgBouncer) in production. Prisma opens `num_cpus * 2 + 1`
  // connections by default — 25 on the dev desktop — and every one of those is a
  // real Postgres backend holding RAM on the Neon compute. Transaction-mode
  // pooling multiplexes them onto a handful of backends instead.
  url        = env("DATABASE_URL")
  // Migrations and introspection cannot run through PgBouncer (they need
  // session state and prepared statements), so they take the direct endpoint.
  // Locally both point at the same database and nothing changes.
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ── Identity / auth ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  timezone     String   @default("UTC")
  // Proactive engine prefs: master switch + local hour (0-23) to fire the daily
  // brief / weekly review, interpreted in `timezone`.
  proactiveEnabled Boolean @default(true)
  briefHour        Int     @default(7)
  // How weights are shown and typed: "lb" | "kg". Storage is always integer
  // grams — this is a display preference only, so changing it never rewrites a
  // single logged set. Defaults to lb.
  weightUnit   String   @default("lb")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  credentials       Credential[]
  pushSubscriptions PushSubscription[]
  routineBlocks     RoutineBlock[]
  tasks          Task[]
  events         Event[]
  habits         Habit[]
  habitLogs      HabitLog[]
  journalEntries JournalEntry[]
  notes          Note[]
  goals          Goal[]
  exercises      Exercise[]
  workouts       Workout[]
  workoutTemplates WorkoutTemplate[]
  workoutSets    WorkoutSet[]
  accounts       Account[]
  transactions   Transaction[]
  timelineEvents TimelineEvent[]
  embeddings     Embedding[]
  insights       Insight[]
  aiQuestions    AiQuestion[]
  aiUsage        AiUsage[]

  @@map("users")
}

/**
 * One recurring block of the user's typical week ("sleep 23:00–07:00 daily",
 * "work 9–17 weekdays"). Captured by onboarding; read by the stream (what you're
 * supposed to be doing right now) and by the AI (it knows your schedule).
 */
model RoutineBlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  kind      String   @default("custom") // sleep | work | school | meal | exercise | winddown | custom
  // Which weekdays this block applies to: 7-bit mask, bit 0 = Monday … bit 6 = Sunday.
  // Ignored entirely when `onDate` is set.
  days      Int      @default(127)
  // A SINGLE local date this block applies to, as YYYY-MM-DD. Null = the normal
  // weekly pattern. This is what makes irregular/shift work expressible at all:
  // those users have no weekly rule, they have "working 7–3 this Tuesday".
  // Stored as text, not a DateTime, because it is a calendar date in the user's
  // own local frame — a timestamp would drift across timezones and DST.
  onDate    String?
  // Minutes from local midnight. start > end means the block wraps past midnight (sleep).
  startMin  Int
  endMin    Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, onDate])
  @@map("routine_blocks")
}

/**
 * A browser Web Push subscription (one per device/browser). Endpoint is unique;
 * a subscription that returns 404/410 on send is stale and gets pruned.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Session token is stored hashed; the raw token lives only in the client cookie.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

// ── Connector credentials (the "tons of API keys" store) ─────────────────────

model Credential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which connector this belongs to, e.g. "google-calendar", "openrouter", "simplefin".
  connector String
  // Human label so a user can have >1 of the same connector.
  label     String   @default("default")
  // AES-256-GCM ciphertext (base64) of the secret payload. Never plaintext.
  dataEnc   String
  // Non-secret metadata safe to read (scopes, account name, expiry hints).
  meta      Json?
  status    String   @default("active") // active | error | revoked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, connector, label])
  @@index([userId])
  @@map("credentials")
}

// ── Domain: Tasks (the Phase 0 vertical slice) ───────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  // Free-form tags; lets the AI and future modules group without schema changes.
  tags        String[]     @default([])
  // Optional link back to a goal.
  goalId      String?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  // RFC 5545 RRULE ("FREQ=WEEKLY;BYDAY=MO,WE"). Null = one-off. Rules we can't
  // parse are stored verbatim and simply never expanded — never rewritten.
  recurrence  String?
  // Set on a materialised instance; points at the series root task.
  recurrenceParentId String?
  // Blocks reserved for this task; their spans are the raw material for
  // "usually takes you ~1h 20m".
  blocks      Event[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, recurrenceParentId])
  @@map("tasks")
}

// ── Domain: Calendar events (Phase 1) ────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean   @default(false)
  // Provenance for two-way sync (e.g. Google Calendar event id + connector).
  source      String    @default("atlas")
  externalId  String?
  // WHICH calendar at the source this came from — Google's "Work", "Climbing",
  // a shared family calendar. Null means primary, which is what every row
  // written before Atlas could see past `primary` actually is.
  //
  // Deliberately NOT part of the unique key. A meeting you are invited to
  // carries the SAME Google event id on every calendar it appears on, so
  // keying on it as well would import that meeting twice and show it twice on
  // the same day. One row per event is the truthful shape; this column records
  // where it was found, so turning a calendar off can take its events with it.
  sourceCalendarId String?
  // RRULE for a repeating series; the row itself is the first occurrence.
  // Google sends `singleEvents=true` instances, so synced rows stay null.
  recurrence  String?
  recurrenceParentId String?
  // The task this block was reserved for, when it was scheduled from one
  // ("Plan my day", or the AI's calendar.block). This is what lets Atlas learn
  // how long work ACTUALLY takes: the block says when you started, the task's
  // completedAt says when you stopped. Cleared rather than cascaded, so
  // deleting a task never silently removes time from your calendar.
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, taskId])
  // Scoped by user: an external id is only unique WITHIN an account. A calendar
  // event shared between two Atlas users carries the same Google id for both,
  // so a global unique would collide and let one user's sync overwrite the
  // other's row. (Postgres treats NULLs as distinct, so unsynced local events
  // with externalId=null never conflict.)
  @@unique([userId, source, externalId])
  @@index([userId, startAt])
  @@map("events")
}

// ── Domain: Habits & goals (Phase 1) ─────────────────────────────────────────

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cadence   String     @default("daily") // daily | weekly | custom-rrule
  target    Int        @default(1) // e.g. 1x/day, 3x/week
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      HabitLog[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  loggedAt DateTime @default(now())
  value   Int      @default(1)
  note    String?

  @@index([habitId, loggedAt])
  @@map("habit_logs")
}

// ── Domain: Fitness / strength training (v7) ─────────────────────────────────

// The movement itself, not a performance of it. Rows are either seeded catalog
// entries (userId null, shared and read-only) or a user's own additions, so a
// custom lift never leaks between accounts.
model Exercise {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Primary muscle group: chest | back | legs | shoulders | arms | core |
  // cardio | other. Coarse on purpose — it is what the muscle-balance chart is
  // built on, and every row already stores it.
  muscle    String   @default("other")
  // The SPECIFIC muscle, and what you do it with. Both nullable: a user's own
  // addition should be loggable without classifying it first, and every row
  // that existed before these columns is genuinely unclassified rather than
  // wrongly classified. Searching "legs" could not find a hip abduction
  // machine, which is what these are for.
  target    String?
  equipment String?
  // How a set of this movement is measured, which decides what the logger asks
  // for: weight_reps | reps | duration | distance.
  kind      String   @default("weight_reps")
  createdAt DateTime @default(now())

  sets         WorkoutSet[]
  inTemplates  TemplateExercise[]

  // Two users may each add their own "Nordic Curl" without colliding, because
  // Postgres treats NULLs as distinct. Note the flip side: this constraint does
  // NOT dedupe the seeded rows either (they all have userId = null), which is
  // why FitnessService.seedCatalog checks names explicitly instead of trusting
  // `skipDuplicates`.
  @@unique([userId, name])
  @@index([userId])
  @@map("exercises")
}

// One training session. `endedAt` null means it is STILL IN PROGRESS — that is
// how the app finds the workout to resume, so there is at most one open per user.
/**
 * A named day in the user's split — "Push", "Pull", "Legs", "Upper A".
 *
 * The point is that mid-workout you should never scroll a 32-item catalog to
 * find the movement you do every single week. A template is the ordered list
 * of what you actually do on that day, and the picker floats it to the top.
 */
model WorkoutTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Ordering in the "start a workout" list — most-used days first.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises TemplateExercise[]
  workouts  Workout[]

  // One "Push" per person. Unlike the exercise catalog every row here has a
  // real userId, so this constraint actually dedupes.
  @@unique([userId, name])
  @@index([userId, position])
  @@map("workout_templates")
}

/** One movement in a template, in the order it is performed. */
model TemplateExercise {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position   Int             @default(0)

  @@unique([templateId, exerciseId])
  @@index([templateId, position])
  @@map("template_exercises")
}

model Workout {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Workout")
  notes     String?
  // Which template this session came from, if any. Nullable and SetNull on
  // delete: deleting a template must never delete the history of sessions that
  // used it.
  templateId String?
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sets      WorkoutSet[]

  @@index([userId, startedAt])
  @@map("workouts")
}

// A single logged set. Weight is stored in GRAMS as an integer: kg/lb floats
// accumulate rounding error over a volume sum, and 2.5 kg plate maths must stay
// exact. Duration is seconds, distance is metres — all integers for the same
// reason.
model WorkoutSet {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // Order within the workout, so exercises and their sets render as logged.
  position   Int      @default(0)
  weightGrams Int?
  reps       Int?
  durationSec Int?
  distanceM  Int?
  // A warm-up set counts toward neither volume nor a personal record.
  warmup     Boolean  @default(false)
  completedAt DateTime @default(now())

  @@index([workoutId, position])
  @@index([userId, exerciseId, completedAt])
  @@map("workout_sets")
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  status      String    @default("active") // active | achieved | paused | dropped
  // "short" | "long". Explicit rather than inferred from targetDate: whether
  // something is a long-term goal is a judgement about ambition, not about how
  // many weeks away it is, and a goal with no date still has a horizon.
  horizon     String    @default("short")
  // Ordering within its horizon column.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([userId, status])
  @@index([userId, horizon, position])
  @@map("goals")
}

// ── Domain: Journal & notes (Phase 1) ────────────────────────────────────────

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The day this entry is *about* (may differ from createdAt).
  entryDate DateTime
  body      String
  mood      Int? // optional 1..5 scale
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryDate])
  @@map("journal_entries")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notes")
}

// ── Domain: Finance (Phase 3) ────────────────────────────────────────────────

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String        @default("checking") // checking | savings | credit | cash | investment
  currency     String        @default("USD")
  // Balance in minor units (cents) to avoid float error.
  balanceMinor BigInt        @default(0)
  source       String        @default("manual")
  externalId   String?
  // Bank connection metadata (Plaid): last-4 of the account number + institution name.
  mask         String?
  institution  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  // Per-user, for the same reason as Event — see the note there.
  @@unique([userId, source, externalId])
  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Signed amount in minor units. Negative = money out.
  amountMinor BigInt
  currency    String   @default("USD")
  description String
  category    String?
  // A cleaner merchant label when the source provides one (Plaid merchant_name).
  merchantName String?
  postedAt    DateTime
  // Plaid marks a transaction pending until it settles; the amount/date can still change.
  pending     Boolean  @default(false)
  source      String   @default("manual")
  externalId  String?
  createdAt   DateTime @default(now())

  // Per-user, for the same reason as Event — see the note there.
  @@unique([userId, source, externalId])
  @@index([userId, postedAt])
  @@index([accountId, postedAt])
  @@map("transactions")
}

// ── Unified life log: the cross-domain view the AI reads ──────────────────────

model TimelineEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "task.created", "habit.logged", "journal.written", "txn.synced".
  type       String
  // Which module/connector produced it, e.g. "tasks", "google-calendar".
  source     String
  title      String
  summary    String?
  // Structured detail + a soft link to the originating record.
  refType    String? // e.g. "task"
  refId      String?
  payload    Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@map("timeline_events")
}

// ── AI memory & self-curation ────────────────────────────────────────────────

// Vector store for semantic retrieval over any record (journal, notes, tasks…).
// The `embedding` column is a pgvector type; Prisma can't type it, so similarity
// search is done via $queryRaw (see packages/ai). Dimension is model-dependent;
// 768 is a placeholder for small embedding models and can be changed early.
model Embedding {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerType String // "journal" | "note" | "task" | ...
  ownerId   String
  content   String // the exact text that was embedded
  model     String
  embedding Unsupported("vector(768)")?
  createdAt DateTime                     @default(now())

  @@unique([ownerType, ownerId])
  @@index([userId])
  @@map("embeddings")
}

// Derived insights the AI writes back (patterns, summaries). First-class data so
// the AI accumulates knowledge instead of re-deriving it every run.
model Insight {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // "daily_brief" | "pattern" | "rolling_summary" | ...
  title      String
  body       String
  // Scope window this insight summarizes, for rolling summaries.
  periodFrom DateTime?
  periodTo   DateTime?
  meta       Json?
  createdAt  DateTime  @default(now())

  @@index([userId, kind, createdAt])
  @@map("insights")
}

enum AiQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

// The unique hook: questions the AI asks the user to fill knowledge gaps.
model AiQuestion {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  // Why the AI is asking / what it will do with the answer.
  rationale  String?
  // What domain this relates to, so the answer can be routed back.
  relatesTo  String? // "finance" | "habits" | ...
  status     AiQuestionStatus @default(OPEN)
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, status])
  @@map("ai_questions")
}

// Cost guard ledger. One row per AI call; aggregated per day to enforce the cap.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  day              DateTime @db.Date
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  // Subset of promptTokens the provider served from its prefix cache. Recorded
  // because it's the only direct signal that prompt caching still works —
  // a cache regression is silent (no error, just a ~3.5x bill), and without
  // this the hit rate can only be inferred backwards from cost.
  cachedPromptTokens Int    @default(0)
  // Cost in micro-USD (1e-6 USD) to keep integer precision.
  costUsdMicros    Int      @default(0)
  purpose          String // "daily_brief" | "chat" | "auto_organize" | ...
  createdAt        DateTime @default(now())

  @@index([day])
  @@index([userId, day])
  @@map("ai_usage")
}
